% [1] Arquitectura A — la CNN desde cero.
% Los bloques Inception con reducciones 1x1 de pregunta1/paso3_modelos/inception.py
% salen de aquí. La razón de elegirla: ramas paralelas de 1x1, 3x3 y 5x5 a la
% misma profundidad, que capturan hallazgos de escalas muy distintas (una rotura
% meniscal son milímetros, un derrame ocupa la cápsula) sin añadir profundidad,
% que es lo que 576 estudios no toleran. PDF local: doc/GooGleNet.pdf
@inproceedings{szegedy2015going,
  title     = {Going Deeper with Convolutions},
  author    = {Szegedy, Christian and Liu, Wei and Jia, Yangqing and
               Sermanet, Pierre and Reed, Scott and Anguelov, Dragomir and
               Erhan, Dumitru and Vanhoucke, Vincent and Rabinovich, Andrew},
  booktitle = {IEEE Conference on Computer Vision and Pattern Recognition (CVPR)},
  pages     = {1--9},
  year      = {2015},
}

% [2] Arquitectura B — el backbone preentrenado en ImageNet.
% ResNet-50 con pesos IMAGENET1K_V2, en pregunta1/paso3_modelos/modelos.py.
% El examen la nombra explícitamente. El BottleneckBlock es lo que distingue a
% ResNet-50 de ResNet-18. PDF local: doc/ResNet.pdf
@inproceedings{he2016deep,
  title     = {Deep Residual Learning for Image Recognition},
  author    = {He, Kaiming and Zhang, Xiangyu and Ren, Shaoqing and Sun, Jian},
  booktitle = {IEEE Conference on Computer Vision and Pattern Recognition (CVPR)},
  pages     = {770--778},
  year      = {2016},
}

% [3] El pooling por atención — el componente que el examen exige implementar.
% pregunta1/paso3_modelos/pooling.py sigue esta formulación, incluida la rama
% con compuerta (sigmoide). Resuelve el problema central de la tarea: pasar de
% ocho grupos de cortes a una predicción por estudio sin diluir un hallazgo que
% ocupa dos o tres cortes de treinta.
% Nota: la ablación de este trabajo encontró que la media SUPERA a la atención
% de forma significativa (+0.103, IC95% [+0.048, +0.159]) con 416 estudios de
% entrenamiento. Se cita porque es la base de la implementación, no porque el
% resultado lo confirme.
@inproceedings{ilse2018attention,
  title     = {Attention-based Deep Multiple Instance Learning},
  author    = {Ilse, Maximilian and Tomczak, Jakub M. and Welling, Max},
  booktitle = {International Conference on Machine Learning (ICML)},
  pages     = {2127--2136},
  year      = {2018},
}

% [4] Grad-CAM — el entregable #5 completo.
% pregunta1/paso5_ablacion_gradcam/gradcam.py está escrito desde cero siguiendo
% este método: gradiente del logit respecto del último mapa convolucional,
% promediado por canal, combinado y rectificado. Ninguno de los notebooks del
% curso lo implementa (verificado: cero register_forward_hook en los cuatro).
@inproceedings{selvaraju2017grad,
  title     = {Grad-CAM: Visual Explanations from Deep Networks via
               Gradient-based Localization},
  author    = {Selvaraju, Ramprasaath R. and Cogswell, Michael and Das, Abhishek
               and Vedantam, Ramakrishna and Parikh, Devi and Batra, Dhruv},
  booktitle = {IEEE International Conference on Computer Vision (ICCV)},
  pages     = {618--626},
  year      = {2017},
}

% [5] NegEx — la detección de negación del extractor de etiquetas débiles.
% pregunta1/paso1_etiquetas_debiles/negacion.py aplica este esquema: ventana de
% seis palabras alrededor del término, con disparadores previos y posteriores.
% Es lo que convirtió un buscador de palabras clave inservible (44.8% de acuerdo
% en Medial Meniscus, 18 falsos positivos en ACL sobre 58 estudios) en un
% extractor de 74.0%: los informes radiológicos enumeran lo que NO encontraron.
@article{chapman2001simple,
  title   = {A Simple Algorithm for Identifying Negated Findings and Diseases
             in Discharge Summaries},
  author  = {Chapman, Wendy W. and Bridewell, Will and Hanbury, Paul and
             Cooper, Gregory F. and Buchanan, Bruce G.},
  journal = {Journal of Biomedical Informatics},
  volume  = {34},
  number  = {5},
  pages   = {301--310},
  year    = {2001},
}

